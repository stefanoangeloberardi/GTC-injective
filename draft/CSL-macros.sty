% Custom mapsto with tail
\newcommand{\mmapsto}{\mapstochar\relbar\mathrel{\mkern-12mu}\mapsto}

% Smaller downward version, scaled and rotated
\newcommand{\downmapsto}{\mathrel{\scalebox{0.7}[0.7]{\rotatebox[origin=c]{270}{$\mmapsto$}}}}

\newcommand{\biRel}{\mathcal{R}}
\newcommand{\Graph}{\mathcal{G}}
\newcommand{\Nat}{\mathbb{N}}
\newcommand{\ppath}{\pi}
\newcommand{\Then}{\Longrightarrow}
\newcommand{\dom}[1]{{\textit dom}( #1 )}
\newcommand{\cod}[1]{{\textit cod}( #1 )}

\newcommand{\Set}[1]{\{ #1 \}}

\newcommand{\edgestar}[3]{#1 : #2 \to^* #3}
\newcommand{\edge}[3]{#1 : #2 \to #3}

\newcommand{\edgeGstar}[4]{#1 : #2 \to_{#4}^* #3}
\newcommand{\edgeG}[4]{#1 : #2 \to_{#4} #3}
\newcommand{\myor}{\;\vee\;}

\newcommand{\comp}{\bullet}

\newcommand{\source}[1]{\textit{src}( #1 )}
\newcommand{\target}[1]{\textit{trg}( #1 )}
\newcommand{\lbl}[1]{\textit{lbl}( #1 )}

