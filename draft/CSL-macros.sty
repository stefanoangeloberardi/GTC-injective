% Custom mapsto with tail
\newcommand{\mmapsto}{\mapstochar\relbar\mathrel{\mkern-12mu}\mapsto}

% Smaller downward version, scaled and rotated
\newcommand{\downmapsto}{\mathrel{\scalebox{0.7}[0.7]{\rotatebox[origin=c]{270}{$\mmapsto$}}}}