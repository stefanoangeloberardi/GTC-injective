@article{Mirai,
title = {Cyclic proofs and size-change termination},
journal = {Theoretical Computer Science},
volume = {1045},
pages = {115273},
year = {2025},
issn = {0304-3975},
doi = {https://doi.org/10.1016/j.tcs.2025.115273},
url = {https://www.sciencedirect.com/science/article/pii/S0304397525002117},
author = {Mirai Ikebuchi},
keywords = {Cyclic proof, Size-change termination, Intuitionistic logic},
abstract = {A cyclic proof is a regular infinite proof tree with a global condition, and it is known that, under arithmetic, cyclic proofs with inductive definitions are equivalent to proofs with induction. A way to show this equivalence is by constructing a well-founded relation on tuples of natural numbers and then transforming a cyclic proof into a proof by well-founded induction with the relation. In this paper, we see the connection between cyclic proofs and size-change termination (SCT) of programs, and it provides a new well-founded relation for proof transformation.}
}

@InProceedings{Berardi,
author="Berardi, Stefano
and Tatsuta, Makoto",
editor="C{\^i}rstea, Corina",
title={Intuitionistic Podelski-Rybalchenko Theorem and Equivalence Between Inductive Definitions and Cyclic Proofs},
